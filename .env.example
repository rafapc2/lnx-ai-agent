# ---------- General ----------
ENV=local

# ---------- Postgres (pgvector) ----------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=leanix_agent
POSTGRES_USER=leanix
POSTGRES_PASSWORD=leanix_password

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- LeanIX ----------
# Base URL de tu API / proxy (ajusta a tu entorno)
LEANIX_API_BASE=https://your-leanix.example/api
# Token/Bearer (o el método que uses)
LEANIX_API_TOKEN=replace_me

# ---------- Internal service URLs (docker network) ----------
LEANIX_MCP_URL=http://leanix-mcp:8002
SNAPSHOT_SERVICE_URL=http://snapshot-service:8001

# ---------- Agent ----------
AGENT_REQUIRE_EVIDENCE=true
